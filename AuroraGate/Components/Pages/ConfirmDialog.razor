@if (open)
{
    <div class="card p-3">
        <h5>@Title</h5>
        <p>@Message</p>
        <div class="d-flex gap-2">
            <button class="btn btn-danger" @onclick="Confirm">Sí, eliminar</button>
            <button class="btn btn-secondary" @onclick="Close">Cancelar</button>
        </div>
    </div>
}

@code {
    private bool open;

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public EventCallback OnConfirm { get; set; }

    public void Open() { open = true; StateHasChanged(); }
    private void Close() { open = false; StateHasChanged(); }
    private async Task Confirm() { await OnConfirm.InvokeAsync(); Close(); }
}
